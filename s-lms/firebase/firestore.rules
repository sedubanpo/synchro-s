rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? currentUserDoc().data.role
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.isAdmin == true ||
        currentUserRole() == 'ADMIN'
      );
    }

    function isStaffOrAdmin() {
      return isAdmin() || (
        signedIn() && (
          request.auth.token.role == 'STAFF' ||
          request.auth.token.role == 'DESK' ||
          currentUserRole() == 'STAFF' ||
          currentUserRole() == 'DESK'
        )
      );
    }

    function isInstructor() {
      return signedIn() && (
        request.auth.token.role == 'INSTRUCTOR' ||
        currentUserRole() == 'INSTRUCTOR'
      );
    }

    function canWriteJikboStatus() {
      return isStaffOrAdmin() || isInstructor();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasStudentAccess(studentId) {
      return isAdmin() || (
        signedIn() &&
        request.auth.token.allowedStudentIds is list &&
        studentId in request.auth.token.allowedStudentIds
      );
    }

    function hasStudentPermissionDoc(studentId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.loginId is string &&
          currentUserDoc().data.loginId != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.loginId))
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.instructorId is string &&
          currentUserDoc().data.instructorId != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.instructorId))
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.teacherId is string &&
          currentUserDoc().data.teacherId != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.teacherId))
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.phone is string &&
          currentUserDoc().data.phone != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.phone))
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.phoneNumber is string &&
          currentUserDoc().data.phoneNumber != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.phoneNumber))
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.mobile is string &&
          currentUserDoc().data.mobile != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.mobile))
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          currentUserDoc().data.mobilePhone is string &&
          currentUserDoc().data.mobilePhone != '' &&
          exists(/databases/$(database)/documents/studentPermissions/$(studentId + '__' + currentUserDoc().data.mobilePhone))
        )
      );
    }

    function canUseMonthlyReport(studentId) {
      return isStaffOrAdmin() || hasStudentAccess(studentId) || hasStudentPermissionDoc(studentId);
    }

    function canWriteStudentGrade(studentId) {
      return studentId is string &&
        studentId != '' &&
        (isStaffOrAdmin() || isInstructor() || hasStudentAccess(studentId) || hasStudentPermissionDoc(studentId));
    }

    function canSubmitLiveTimetableAttendance(data) {
      return signedIn()
        && data.reporterUid == request.auth.uid
        && currentUserDoc().data.name is string
        && data.reporterName == currentUserDoc().data.name
        && data.studentId is string
        && data.studentId != ''
        && exists(/databases/$(database)/documents/students/$(data.studentId))
        && data.status in ['출석', '지각', '결석', '결석 예정', '시간 변동', '기타']
        && data.note is string
        && data.note.size() <= 500
        && (isAdmin() || isInstructor());
    }

    function isValidLiveTimetableAttendanceCreate(data) {
      return data.keys().hasOnly([
          'reporterUid', 'reporterName', 'studentId', 'studentName', 'school',
          'sheetName', 'dateKey', 'hour', 'room', 'subject', 'lessonType',
          'status', 'note', 'teacherRevision', 'deskState', 'reportedAt',
          'reportedAtMs', 'deskReply', 'deskRevision',
          'deskHandledTeacherRevision', 'teacherSeenDeskRevision',
          'createdAt', 'createdAtMs'
        ])
        && data.keys().hasAll([
          'reporterUid', 'reporterName', 'studentId', 'studentName', 'school',
          'sheetName', 'dateKey', 'hour', 'room', 'subject', 'lessonType',
          'status', 'note', 'teacherRevision', 'deskState', 'reportedAt',
          'reportedAtMs', 'deskReply', 'deskRevision',
          'deskHandledTeacherRevision', 'teacherSeenDeskRevision',
          'createdAt', 'createdAtMs'
        ])
        && data.reporterName is string && data.reporterName.size() > 0 && data.reporterName.size() <= 80
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 80
        && data.school is string && data.school.size() <= 120
        && data.sheetName is string && data.sheetName.size() > 0 && data.sheetName.size() <= 120
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hour is int && data.hour >= 0 && data.hour <= 23
        && data.room is string && data.room.size() > 0 && data.room.size() <= 120
        && data.subject is string && data.subject.size() <= 120
        && data.lessonType is string && data.lessonType.size() <= 120
        && data.reportedAt == request.time && data.reportedAtMs is number && data.reportedAtMs > 0
        && data.createdAt == request.time && data.createdAtMs == data.reportedAtMs
        && data.deskReply == ''
        && data.deskRevision == 0
        && data.deskHandledTeacherRevision == 0
        && data.teacherSeenDeskRevision == 0;
    }

    function currentUserFieldMatches(value, field) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserDoc().data[field] is string &&
        currentUserDoc().data[field] != '' &&
        currentUserDoc().data[field] == value;
    }

    function ownsMonthlyReportData(data) {
      return signedIn() && (
        data.authorId == request.auth.uid ||
        data.createdById == request.auth.uid ||
        currentUserFieldMatches(data.authorId, 'loginId') ||
        currentUserFieldMatches(data.authorId, 'instructorId') ||
        currentUserFieldMatches(data.authorId, 'teacherId') ||
        currentUserFieldMatches(data.authorId, 'phone') ||
        currentUserFieldMatches(data.authorId, 'phoneNumber') ||
        currentUserFieldMatches(data.authorId, 'mobile') ||
        currentUserFieldMatches(data.authorId, 'mobilePhone') ||
        currentUserFieldMatches(data.authorId, 'email') ||
        currentUserFieldMatches(data.authorId, 'name') ||
        currentUserFieldMatches(data.createdById, 'loginId') ||
        currentUserFieldMatches(data.createdById, 'instructorId') ||
        currentUserFieldMatches(data.createdById, 'teacherId') ||
        currentUserFieldMatches(data.createdById, 'phone') ||
        currentUserFieldMatches(data.createdById, 'phoneNumber') ||
        currentUserFieldMatches(data.createdById, 'mobile') ||
        currentUserFieldMatches(data.createdById, 'mobilePhone') ||
        currentUserFieldMatches(data.createdById, 'email') ||
        currentUserFieldMatches(data.createdById, 'name')
      );
    }

    match /loginAliases/{aliasHash} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /userProfiles/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /userAppAccess/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /studentIdentityMappings/{mappingId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /studentIdentityReviewQueue/{reviewId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accountManagementRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accountManagementAuditLogs/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /sharedIconAssets/{iconId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /legacySheetSyncJobs/{jobId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /legacySheetSyncErrors/{errorId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /studentGrades/{gradeId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && canWriteStudentGrade(request.resource.data.studentId);
      allow update: if signedIn()
        && canWriteStudentGrade(resource.data.studentId)
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isAdmin();
    }

    match /studentGradeHistories/{historyId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && canWriteStudentGrade(request.resource.data.studentId);
      allow update, delete: if isAdmin();
    }

    match /studentLogs/{logId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && (
          request.resource.data.createdById == request.auth.uid ||
          isAdmin() ||
          (
            request.resource.data.restoredFromRowNumber is string &&
            request.resource.data.reactionsByUser is map
          )
        )
        && request.resource.data.studentId is string
        && request.resource.data.content is string;
      allow update: if signedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactions',
            'reactionsJson',
            'reactionsByUser',
            'reactionsUpdatedAt'
          ]) ||
          (
            (isAdmin() || resource.data.createdById == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content',
              'contactMethod',
              'tags',
              'tagsText',
              'updatedAt',
              'updatedAtMs',
              'updatedById',
              'updatedByName'
            ])
            && request.resource.data.content is string
            && request.resource.data.updatedById == request.auth.uid
          )
        );
      allow delete: if signedIn()
        && (isAdmin() || resource.data.createdById == request.auth.uid);
    }

    match /dashboardSnapshots/{snapshotId} {
      allow get: if (snapshotId == 'GLOBAL_NOTICE' && signedIn()) ||
        isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create, update: if signedIn()
        && (
          (
            snapshotId == 'GLOBAL_NOTICE' &&
            isAdmin() &&
            request.resource.data.type == 'globalNotice' &&
            request.resource.data.content is string
          ) ||
          (
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.snapshotJson is string
          )
        );
      allow delete: if false;
    }

    match /permissionRequests/{requestId} {
      allow get: if isAdmin() || (
        signedIn() &&
        (resource.data.instructorId == request.auth.uid || resource.data.instructorUid == request.auth.uid)
      );
      allow list: if isAdmin() || (
        signedIn() &&
        (resource.data.instructorId == request.auth.uid || resource.data.instructorUid == request.auth.uid)
      );
      allow create: if signedIn() && (
        request.resource.data.instructorId == request.auth.uid ||
        request.resource.data.instructorUid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /permissionReviewQueue/{reviewId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /studentPermissions/{documentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /liveTimetableAttendanceReports/{reportId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if canSubmitLiveTimetableAttendance(request.resource.data)
        && isValidLiveTimetableAttendanceCreate(request.resource.data)
        && request.resource.data.teacherRevision == 1
        && request.resource.data.deskState == 'NEW'
        && request.resource.data.deskRevision == 0;
      allow update: if (
        canSubmitLiveTimetableAttendance(request.resource.data)
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sheetName == resource.data.sheetName
        && request.resource.data.hour == resource.data.hour
        && request.resource.data.room == resource.data.room
        && request.resource.data.teacherRevision == resource.data.teacherRevision + 1
        && request.resource.data.deskState == 'NEW'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'note',
          'teacherRevision',
          'deskState',
          'reportedAt',
          'reportedAtMs'
        ])
      ) || (
        signedIn()
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.teacherSeenDeskRevision is int
        && request.resource.data.teacherSeenDeskRevision >= resource.data.teacherSeenDeskRevision
        && request.resource.data.teacherSeenDeskRevision <= resource.data.deskRevision
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherSeenDeskRevision'])
      ) || (
        isAdmin()
        && request.resource.data.deskState in ['ACKNOWLEDGED', 'RESOLVED']
        && request.resource.data.deskReply is string
        && request.resource.data.deskReply.size() <= 500
        && request.resource.data.deskRevision == resource.data.deskRevision + 1
        && request.resource.data.deskHandledTeacherRevision == resource.data.teacherRevision
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deskState',
          'deskReply',
          'deskRevision',
          'deskHandledTeacherRevision',
          'deskUpdatedByUid',
          'deskUpdatedByName',
          'deskUpdatedAt',
          'deskUpdatedAtMs'
        ])
      );
      allow delete: if false;

      match /events/{eventId} {
        allow get, list: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
        allow create: if (
          request.resource.data.type == 'TEACHER_SUBMITTED'
          && canSubmitLiveTimetableAttendance(request.resource.data)
          && request.resource.data.keys().hasOnly([
            'type', 'reporterUid', 'studentId', 'teacherRevision', 'status', 'note', 'createdAt', 'createdAtMs'
          ])
          && request.resource.data.teacherRevision is int
          && request.resource.data.createdAtMs is number
          && getAfter(/databases/$(database)/documents/liveTimetableAttendanceReports/$(reportId)).data.reporterUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/liveTimetableAttendanceReports/$(reportId)).data.studentId == request.resource.data.studentId
          && getAfter(/databases/$(database)/documents/liveTimetableAttendanceReports/$(reportId)).data.teacherRevision == request.resource.data.teacherRevision
        ) || (
          request.resource.data.type == 'DESK_REPLIED'
          && isAdmin()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'type', 'reporterUid', 'studentId', 'deskState', 'deskReply', 'deskRevision', 'actorUid', 'createdAt', 'createdAtMs'
          ])
          && request.resource.data.deskState in ['ACKNOWLEDGED', 'RESOLVED']
          && request.resource.data.deskReply is string
          && request.resource.data.deskReply.size() <= 500
          && request.resource.data.deskRevision is int
          && request.resource.data.createdAtMs is number
          && getAfter(/databases/$(database)/documents/liveTimetableAttendanceReports/$(reportId)).data.reporterUid == request.resource.data.reporterUid
          && getAfter(/databases/$(database)/documents/liveTimetableAttendanceReports/$(reportId)).data.studentId == request.resource.data.studentId
          && getAfter(/databases/$(database)/documents/liveTimetableAttendanceReports/$(reportId)).data.deskRevision == request.resource.data.deskRevision
        );
        allow update, delete: if false;
      }
    }

    match /liveTimetableAttendanceNotifications/{uid} {
      allow get, list, create, update, delete: if false;

      match /items/{reportId} {
        allow get, list: if isAdmin() || isSelf(uid);
        allow create, update: if (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            'reportId', 'reporterUid', 'deskRevision', 'deskState', 'seen', 'updatedAt', 'updatedAtMs'
          ])
          && request.resource.data.reportId == reportId
          && request.resource.data.reporterUid == uid
          && request.resource.data.deskRevision is int
          && request.resource.data.deskState in ['ACKNOWLEDGED', 'RESOLVED']
          && request.resource.data.seen == false
          && request.resource.data.updatedAtMs is number
        ) || (
          isSelf(uid)
          && resource.data.reporterUid == request.auth.uid
          && request.resource.data.reporterUid == resource.data.reporterUid
          && request.resource.data.reportId == resource.data.reportId
          && request.resource.data.seen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'seenAtMs'])
        );
        allow delete: if false;
      }
    }

    match /consultationHiddenLinks/{documentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /studentHomerooms/{documentId} {
      allow get, list: if isStaffOrAdmin();
      allow create, update, delete: if isStaffOrAdmin();
    }

    match /studentMonthlyReports/{reportId} {
      allow get, list: if canUseMonthlyReport(resource.data.studentId);
      allow create: if signedIn()
        && canUseMonthlyReport(request.resource.data.studentId)
        && request.resource.data.studentId is string
        && request.resource.data.month is string
        && request.resource.data.subject in ['국어', '수학', '영어', '과학', '사회']
        && request.resource.data.updatedById == request.auth.uid
        && (isAdmin() || ownsMonthlyReportData(request.resource.data));
      allow update: if signedIn()
        && canUseMonthlyReport(request.resource.data.studentId)
        && request.resource.data.studentId is string
        && request.resource.data.month is string
        && request.resource.data.subject in ['국어', '수학', '영어', '과학', '사회']
        && request.resource.data.updatedById == request.auth.uid
        && resource.data.studentId == request.resource.data.studentId
        && (
          isAdmin() ||
          (
            ownsMonthlyReportData(resource.data) &&
            ownsMonthlyReportData(request.resource.data) &&
            request.resource.data.authorId == resource.data.authorId
          )
        );
      allow delete: if signedIn()
        && canUseMonthlyReport(resource.data.studentId)
        && (
          isAdmin() ||
          ownsMonthlyReportData(resource.data)
        );
    }

    match /events/{eventId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    match /jikboSubjects/{subjectId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    match /jikboStudentOverrides/{overrideId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    match /jikboStatuses/{statusId} {
      allow get, list: if signedIn();
      allow create, update, delete: if canWriteJikboStatus();
    }

    match /jikboChangeLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if canWriteJikboStatus();
      allow update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /materialOpenLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.openedById == request.auth.uid
        && request.resource.data.materialRowNumber is string
        && request.resource.data.link is string
        && request.resource.data.openedAt is string
        && request.resource.data.openedAtMs is number;
      allow update, delete: if isAdmin();
    }

    match /materialSettings/{settingId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /gradeSettings/{settingId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /studentCards/{studentId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /userStudentAccess/{documentId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
